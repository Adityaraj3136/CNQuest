# Firebase Web SDK configuration.
# Copy this file to `.env` and fill in values from:
#   Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup
# Only VITE_-prefixed variables are exposed to the client bundle.
# These are PUBLIC client keys (safe to ship). NEVER put admin/service-account keys here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "true" to point Auth/Firestore at the local Firebase emulators.
VITE_USE_FIREBASE_EMULATORS=false

# Optional: OAuth Web client id (Firebase Console → Authentication → Sign-in method →
# Google → Web SDK configuration). Enables in-app Google sign-in without a popup.
# Add each site origin under "Authorised JavaScript origins" for this client in Google Cloud.
VITE_GOOGLE_CLIENT_ID=
